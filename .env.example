# Copy this file to ".env" (same folder) and change every value.
# ".env" is git-ignored: never commit it.

# Database password. Any long random text.
POSTGRES_PASSWORD=change-me-long-random-database-password

# Key that signs the login tokens. At least 32 characters, random, kept secret.
# Make one with:  openssl rand -base64 48
JWT_SECRET_KEY=change-me-at-least-32-characters-random-secret-key

# The first admin account. It is created only when the database has no admin yet.
# Password: at least 8 characters. Change it from Settings > Security after the first login.
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=change-me-strong-password

# The address people type in the browser to open the system (no slash at the end).
# Examples: http://10.70.34.59   or   http://10.70.34.59:8080   or   https://stock.yourcompany.com
APP_URL=http://10.70.34.59

# Port on the SERVER that DBeaver / pgAdmin / any SQL tool connects to (the database inside Docker
# always stays on 5432; the backend does not use this). It is only open on the server itself
# (127.0.0.1): remote people use an SSH tunnel, see DEPLOY.md "Connect to the database".
POSTGRES_EXTERNAL_PORT=5433

# Which server address that port is opened on. Leave it as 127.0.0.1 (safe, tunnel only).
# Use 0.0.0.0 ONLY if direct remote access is really needed AND the firewall allows just your IPs.
# POSTGRES_BIND_ADDRESS=127.0.0.1

# The port the website listens on, on the server. 80 = normal web port.
APP_PORT=80
